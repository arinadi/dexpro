#!/data/data/com.termux/files/usr/bin/bash
# dexpro launcher — resolves the interpreter and hands off to the app package.
set -euo pipefail

# $PREFIX/bin/dexpro is a symlink to this script; readlink -f resolves it
# back to the repo so this works when invoked as `dexpro` from PATH, not
# just when run directly from the repo dir.
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "dexpro: no python interpreter found" >&2
    exit 1
fi

exec env PYTHONPATH="$REPO_DIR" "$PY" -m app.app "$@"
