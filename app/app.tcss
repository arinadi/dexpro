/* Sized for a phone screen driven by touch: full-width targets, generous
   height, nothing that needs a precise tap. Follows XLabs' app.tcss
   patterns (row2/row3 grouping, wide gutters next to destructive
   buttons) — this file previously had almost none of that, which was
   the single biggest "TUI mengecewakan" contributor per audit.md. */

Screen {
    background: $surface;
}

#menu {
    padding: 1 0;
    align: center top;
}

.screen-title {
    width: 100%;
    padding: 1 2;
    text-style: bold;
    color: $text;
    background: $panel;
}

/* Button rows, used by the main menu and any screen with several
   actions. grid-gutter is 2, not 1: a destructive button (Remove,
   Delete, Reset) often sits right next to a safe one, and a single-cell
   gap is thin enough on a touch screen that a mistap lands on the
   neighbour instead. */
.row2,
.row3 {
    width: 100%;
    height: auto;
    grid-rows: 3;
    grid-gutter: 2;
    margin: 0 2 1 2;
}

.row2 { grid-size: 2; }
.row3 { grid-size: 3; }

.row2 Button,
.row3 Button {
    width: 100%;
    height: 3;
}

/* The Back button on every sub-screen. Every screen nests it inside a
   Vertical/VerticalScroll, not directly under Screen, so this can't use
   a "Screen > Button#back" combinator — it would silently never match. */
Button#back {
    width: 100%;
    height: 3;
    margin: 0 2 1 2;
}

/* ActionScreen's Copy/Back(+Restart) row — Button#back above still
   applies when it's alone; this splits the width when the others are
   also present. */
#action-buttons {
    width: 100%;
    height: auto;
    margin: 0 2 1 2;
}

#action-buttons Button {
    width: 1fr;
    height: 3;
    margin-right: 1;
}

/* The copy button is a single letter, so it does not need an equal share. */
#action-buttons Button#copy {
    width: 7;
}

#box-actions {
    grid-size: 2;
    grid-rows: 4;
    grid-gutter: 1 2;
    padding: 1 2;
    height: auto;
}

#box-actions Button {
    width: 100%;
    height: 3;
}

/* Log widget used by ActionScreen — bordered and visually distinct so a
   running command's output reads as a console, not stray text. */
#log {
    height: 1fr;
    margin: 1 2;
    padding: 1;
    border: round $primary;
    background: $surface-darken-1;
}

#box-table,
#doctor-table,
#backup-table,
#package-table,
#mirror-table,
#repo-table,
#desktop-files {
    height: 1fr;
    margin: 1 2;
}

/* Confirmation modal */
ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#confirm-dialog {
    align: center middle;
    width: 90%;
    max-width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm-dialog Label {
    width: 100%;
    margin-bottom: 1;
}

#confirm-dialog Button {
    width: 100%;
    margin-top: 1;
}

#create-box-dialog {
    align: center middle;
    width: 90%;
    max-width: 60;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#create-box-dialog Input {
    margin-bottom: 1;
}

/* Settings form */
SettingsScreen Label {
    margin: 1 2 0 2;
}

SettingsScreen Select {
    margin: 0 2;
}

#settings-status {
    margin: 1 2;
    padding: 0 1;
    min-height: 1;
    color: $text-muted;
}

/* Store / Mirror / Repos */
#search {
    margin: 1 2 0 2;
}

AddRepoScreen Label {
    margin: 1 2 0 2;
}

AddRepoScreen Input {
    margin: 0 2;
}
